# ===================
# Frontend Environment
# ===================

# Clerk (Authentication)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# API
VITE_API_URL=http://localhost:8000

# Supabase (for direct uploads)
VITE_SUPABASE_URL=https://xxx.supabase.co
VITE_SUPABASE_ANON_KEY=xxx

# Stripe
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ===================
# Backend Environment
# ===================

# App
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:xxx@db.xxx.supabase.co:5432/postgres

# Redis
REDIS_URL=redis://localhost:6379/0

# Clerk
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx

# Supabase Storage
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_KEY=xxx

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ===================
# Worker Environment
# ===================

# Modal (GPU)
MODAL_TOKEN_ID=xxx
MODAL_TOKEN_SECRET=xxx

# Model paths (optional, for local dev)
SDXL_MODEL_PATH=stabilityai/stable-diffusion-xl-base-1.0
IP_ADAPTER_PATH=h94/IP-Adapter
GFPGAN_MODEL_PATH=models/GFPGANv1.4.pth
REALESRGAN_MODEL_PATH=models/RealESRGAN_x4plus.pth
